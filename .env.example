# Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-hotel-secret-key-change-in-production-12345
DATABASE_URL=sqlite:///hotel_management.db

# Hotel Defaults
HOTEL_NAME="Hotel Rooms Management"
HOTEL_CURRENCY="INR"
HOTEL_CURRENCY_SYMBOL="₹"
HOTEL_TIMEZONE="Asia/Kolkata"
HOTEL_TAX_RATE=12.0
HOTEL_RESTAURANT_TAX_RATE=5.0
